# ===== 后端元数据库（默认 H2，可选切换 MySQL profile）=====
# 使用方式：spring.profiles.active=mysql 时生效；控件默认用户名/密码也来自这里
MYSQL_META_URL=jdbc:mysql://127.0.0.1:3306/mvp_backend?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password_here

# ===== Docker Compose 中 MySQL root 密码（默认 root123，仅本地开发）=====
MYSQL_ROOT_PASSWORD=root123

# ===== AI 智能化层（DeepSeek）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 告警邮件（QQ 邮箱 SMTP）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
