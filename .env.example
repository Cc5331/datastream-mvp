# ===== 后端元数据库（默认 H2，可选切换 MySQL profile）=====
# 使用方式：spring.profiles.active=mysql 时生效；控件默认用户名/密码也来自这里
MYSQL_META_URL=jdbc:mysql://127.0.0.1:3306/mvp_backend?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password_here

# ===== Docker Compose 中 MySQL root 密码（必填，不提供默认值）=====
MYSQL_ROOT_PASSWORD=replace_with_a_strong_random_password

# ===== 多数据源演示环境 =====
POSTGRES_DB=dataflow
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
POSTGRES_PORT=5433
ORACLE_USERNAME=dataflow
ORACLE_PASSWORD=replace_with_oracle_password
ORACLE_SYS_PASSWORD=replace_with_oracle_sys_password
ORACLE_PORT=1521
REDIS_PASSWORD=replace_with_a_strong_redis_password
REDIS_PORT=6379
HDFS_RPC_PORT=9000
HDFS_UI_PORT=9870
HDFS_DATANODE_UI_PORT=9864

# ===== 登录安全（首次空库启动必须显式配置）=====
JWT_SECRET=replace_with_at_least_32_random_bytes
BOOTSTRAP_USERS_ENABLED=true
ADMIN_PASSWORD=replace_with_a_strong_admin_password
OPERATOR_PASSWORD=replace_with_a_strong_operator_password
VIEWER_PASSWORD=replace_with_a_strong_viewer_password

# ===== 边界与暴露面 =====
# H2 Web 控制台默认关闭；置 true 才开启（且仅 ADMIN 角色可访问，排障后请改回 false）
H2_CONSOLE_ENABLED=false
# 允许跨域访问 /api 的来源白名单（逗号分隔）；前端 3000 由 serve.js 反代，通常无需放开
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 文件边界 =====
APP_PREVIEW_ALLOWED_ROOTS=../data,../test-resources,../output
APP_PREVIEW_MAX_FILE_BYTES=67108864
# 远程预览 SSRF 白名单；按部署环境填写主机/authority，不支持通配符
APP_PREVIEW_ALLOWED_JDBC_HOSTS=localhost,127.0.0.1,postgres,oracle,mysql
APP_PREVIEW_ALLOWED_HDFS_AUTHORITIES=localhost:9000,namenode:9000
OUTPUT_ROOT=../output

# ===== AI 智能化层（默认 DeepSeek，驱动 NL2Pipeline 与智能诊断 Agent）=====
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 前端可选模型白名单，逗号分隔；只允许选择这里列出的模型
AI_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-flash-vision-exp

# 可选：切换回 OpenAI 时设置 AI_PROVIDER=openai，并填写以下配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# AI 服务商密钥落盘加密密钥；不配置时自动使用 backend/data/.ai_config_key 本机密钥文件（两者都不进仓库）
AI_CONFIG_ENCRYPTION_KEY=
# 仅一次性迁移旧版本（使用固定兜底密钥加密）的历史配置时设置：
# AI_LEGACY_ENCRYPTION_KEY=<旧密钥>，启动后自动用新密钥重新加密落盘，随后可移除

# ===== 告警邮件（QQ 邮箱 SMTP）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
