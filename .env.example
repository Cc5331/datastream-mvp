# ===== 后端元数据库（默认 H2，可选切换 MySQL profile）=====
# 使用方式：spring.profiles.active=mysql 时生效；控件默认用户名/密码也来自这里
MYSQL_META_URL=jdbc:mysql://127.0.0.1:3306/mvp_backend?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password_here

# ===== Docker Compose 中 MySQL root 密码（必填，不提供默认值）=====
MYSQL_ROOT_PASSWORD=replace_with_a_strong_random_password

# ===== AI 智能化层（默认 OpenAI ChatGPT）=====
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# 前端可选模型白名单，逗号分隔；只允许选择这里列出的模型
AI_ALLOWED_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini

# 可选：切换回 DeepSeek 时设置 AI_PROVIDER=deepseek，并填写以下配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 告警邮件（QQ 邮箱 SMTP）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
