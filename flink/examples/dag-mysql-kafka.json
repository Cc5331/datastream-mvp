      \"type\": \"mysql_input\",
      \"label\": \"MySQL 输入\",
      \"params\": {
        \"url\": \"jdbc:mysql://localhost:3306/source_db\",
        \"table\": \"orders\",
        \"username\": \"root\",
        \"password\": \"root123\"
      },
      \"x\": 100,
      \"y\": 300
    },
    {
      \"id\": \"xml_convert\",
      \"type\": \"xml_json\",
