{
  "jobName": "销售区域分析",
  "parallelism": 2,
  "nodes": [
    {
      "id": "sales_in",
      "type": "csv_input",
      "label": "销售输入",
      "params": {
        "path": "test-resources/data/sales.csv",
        "delimiter": ",",
        "hasHeader": true
      },
      "x": 80,
      "y": 250
    },
    {
      "id": "concat",
      "type": "field_concat",
      "label": "拼接区域信息",
      "params": {
        "fields": [
          "region",
          "product_category",
          "sales_person"
        ],
        "separator": "/",
        "newFieldName": "region_category"
      },
      "x": 350,
      "y": 250
    },
    {
      "id": "csv_out",
      "type": "csv_output",
      "label": "销售输出",
      "params": {
        "path": "test-resources/data/output_sales_region.csv",
        "delimiter": ","
      },
      "x": 620,
      "y": 250
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "sales_in",
      "target": "concat"
    },
    {
      "id": "e2",
      "source": "concat",
      "target": "csv_out"
    }
  ]
}